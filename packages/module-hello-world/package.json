{
  "name": "@plentymarkets/hello-world",
  "version": "0.1.0",
  "description": "A minimal example extension that shows how a marketplace extension is structured.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    },
    "./runtime/*": {
      "import": "./dist/runtime/*"
    }
  },
  "files": [
    "dist",
    "marketplace.json",
    "meta"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rimraf dist/runtime && node -e \"require('fs').cpSync('src/runtime','dist/runtime',{recursive:true})\"",
    "playground:dev": "nuxi dev playground",
    "playground:build": "nuxi build playground"
  },
  "dependencies": {
    "@plentymarkets/shop-core": "^1.42.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.1",
    "rimraf": "^5.0.7",
    "typescript": "5.9.3"
  }
}
